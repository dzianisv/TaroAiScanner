{
  "name": "gemini-tarot-proxy",
  "version": "1.1.0",
  "description": "Secure Firebase Cloud Function proxy for Gemini API requests",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@google/genai": "2.13.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.0.2",
    "google-auth-library": "^10.9.0"
  },
  "scripts": {
    "start": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "node --test index.test.js",
    "test:e2e": "node --test e2e.test.js",
    "check": "node --check index.js && node --check index.test.js && node --check e2e.test.js"
  }
}
